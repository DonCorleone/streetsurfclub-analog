# Environment variables for Blogger API integration
GOOGLE_BLOGGER_API_KEY=your-api-key-here
GOOGLE_BLOGGER_ID=your-blog-id-here
BLOG_MAX_RESULTS=300
BLOG_MAX_RESULTS_MOBILE=50

# Label extraction script (scripts/label-posts.mjs)
ANTHROPIC_API_KEY=your-anthropic-api-key-here
GOOGLE_OAUTH_CLIENT_ID=your-oauth-client-id-here
GOOGLE_OAUTH_CLIENT_SECRET=your-oauth-client-secret-here
GOOGLE_OAUTH_REFRESH_TOKEN=   # auto-filled on first --write run
